{
  "manifest_version": 3,
  "name": "淘寶訂單截圖",
  "version": "1.0.1",
  "description": "一鍵截取淘寶訂單詳情（只截訂單範圍），訂單資料會寫入圖片，給「購物記錄表助手」直接讀取。",
  "action": {
    "default_popup": "popup.html",
    "default_title": "淘寶訂單截圖",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": [
    "activeTab",
    "scripting",
    "downloads",
    "tabs",
    "storage"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "commands": {
    "capture-current": {
      "suggested_key": {
        "default": "Alt+Shift+S"
      },
      "description": "截取目前分頁的淘寶訂單"
    }
  }
}